# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-minimum-32-chars

# ── Database (Supabase / PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Example Supabase direct connection:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# ── Super Admin Bootstrap ─────────────────────────────────────────────────────
SUPER_ADMIN_AGENT_ID=ADMIN-001
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_SCREENSHOTS=tournament-screenshots

# ── Razorpay (Phase 5 — Online Deposits) ─────────────────────────────────────
# RAZORPAY_MODE controls which credentials are active.
# Use 'test' for all development/staging work.
# NEVER put live credentials in source control or any frontend code.
RAZORPAY_MODE=test         # test | live
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_keep_secret_never_share
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_never_share

# ── Phase 5 — Platform Payment Settings ──────────────────────────────────────
# These are seeded as defaults in the platform_settings table on first startup.
# Super Admin can update them via the settings API without a code deploy.
# UPI ID for manual deposit screen — configure before accepting manual deposits.
# PLATFORM_UPI_ID=auraplayff@upi
# PLATFORM_UPI_DISPLAY_NAME=AuraPlayFF
# Minimum withdrawal amount (INR, 2 d.p.)
# MIN_WITHDRAWAL_AMOUNT=100.00

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ── Password Reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Phase 7 — Scheduler / Automation ─────────────────────────────────────────
# Set to false in testing environments to prevent scheduler from starting.
SCHEDULER_ENABLED=true
# How many days to retain screenshot files in Supabase Storage before cleanup.
SCREENSHOT_RETENTION_DAYS=30
# Leaderboard in-process cache TTL in seconds (default: 5 minutes).
LEADERBOARD_CACHE_TTL_SECONDS=300
