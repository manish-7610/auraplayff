# ── AuraPlayFF — Git line-ending normalisation ────────────────────────────────
# Normalise all text files to LF in the repository.
# On Windows checkouts, files keep LF (eol=lf) so diffs stay clean
# and the backend (Linux/Docker) never sees CRLF in Python files.

# Default: auto-detect text, normalise to LF
* text=auto eol=lf

# Explicitly text — always LF
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.mako      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary — never modify
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
